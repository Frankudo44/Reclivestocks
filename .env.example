# ============================================================
# REC Livestock — Environment variables
# ============================================================
# The static storefront does NOT read .env files. Supabase URL + anon
# key are committed directly in js/config.js (the anon key is public by
# design and safe for the browser).
#
# The vars below are ONLY used by the Vercel serverless functions in
# api/ (Paystack payment verification). Set them under
# Vercel → Settings → Environment Variables for the Production scope.

# Required for Paystack payments (api/verify-payment.js)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=

# Public Paystack key for the browser (optional — paste into js/config.js)
# PAYSTACK_PUBLIC_KEY=